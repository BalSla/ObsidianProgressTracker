{
  "compilerOptions": {
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "isolatedModules": true,
    "moduleResolution":"node",
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ],
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
